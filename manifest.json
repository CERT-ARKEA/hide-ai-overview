{
  "manifest_version": 3,
  "name": "Bloqueur AI Overview / AI Mode pour Google Search",
  "version": "1.0.0",
  "description": "Masque en permanence l'AI Overview (réponses Gemini) et le menu 'AI Mode' dans les résultats Google Search.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.fr/*",
    "*://www.google.co.uk/*",
    "*://www.google.de/*",
    "*://www.google.es/*",
    "*://www.google.it/*",
    "*://www.google.ca/*",
    "*://www.google.com.au/*",
    "*://www.google.co.jp/*",
    "*://www.google.com.br/*",
    "*://www.google.nl/*",
    "*://www.google.be/*",
    "*://www.google.ch/*",
    "*://www.google.pt/*",
    "*://www.google.pl/*",
    "*://www.google.co.in/*",
    "*://www.google.co.id/*",
    "*://www.google.com.mx/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.fr/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.de/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.com.br/search*",
        "*://www.google.nl/search*",
        "*://www.google.be/search*",
        "*://www.google.ch/search*",
        "*://www.google.pt/search*",
        "*://www.google.pl/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.id/search*",
        "*://www.google.com.mx/search*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bloqueur AI Overview / AI Mode"
  }
}
